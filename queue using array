#include <iostream>
using namespace std;
#define MAX 100

class Queue {
    int arr[MAX];
    int front, rear, count;
public:
    Queue() { front = 0; rear = -1; count = 0; }

    bool isEmpty() { return count == 0; }
    bool isFull() { return count == MAX; }

    void enqueue(int val) {
        if (isFull()) { cout << "Queue is full\n"; return; }
        rear = (rear + 1) % MAX;
        arr[rear] = val;
        count++;
    }

    void dequeue() {
        if (isEmpty()) { cout << "Queue is empty\n"; return; }
        cout << "Dequeued: " << arr[front] << endl;
        front = (front + 1) % MAX;
        count--;
    }
};

int main() {
    Queue q;
    q.enqueue(1);
    q.enqueue(2);
    q.enqueue(3);
    q.dequeue();
    q.dequeue();
    return 0;
}
